. /*--------------------------------------------------------------
>   Step 2: For each grouping dimension, run Fisher permutation test
> --------------------------------------------------------------*/
. 
. * Define grouping dimensions to test
. * We test 6 dimensions, pick the best 3-4
. local dim_list "SOE HighInfoEnv HighSA HighInstHold HighSize HighAnalyst"

. local dim_labels `" "产权性质" "信息环境(行业年度)" "融资约束(SA)" "机构持股"
>  "企业规模" "分析师覆盖(全样本)" "'

. 
. * Store results
. tempname results

. postfile `results' str30 dimension double(b_high b_low diff_obs p_fisher n_hi
> gh n_low) using "/Users/mac/computerscience/15会计研究/results/v9_tables/fish
> er_test_results.dta", replace
(file
    /Users/mac/computerscience/15会计研究/results/v9_tables/fisher_test_resul
    > ts.dta not found)

. 
. local nreps 1000

. 
. local i = 1

. foreach dim of local dim_list {
  2.     local label : word `i' of `dim_labels'
  3.     di _n "=== Testing dimension: `dim' (`label') ==="
  4.     
.     * Observed coefficients from residual regression
.     qui reg resid_y resid_x if `dim' == 1, nocons
  5.     local b_high = _b[resid_x]
  6.     local n_high = e(N)
  7.     
.     qui reg resid_y resid_x if `dim' == 0, nocons
  8.     local b_low = _b[resid_x]
  9.     local n_low = e(N)
 10.     
.     local diff_obs = abs(`b_high' - `b_low')
 11.     
.     di "  High group: b = " %9.6f `b_high' ", N = `n_high'"
 12.     di "  Low group:  b = " %9.6f `b_low' ", N = `n_low'"
 13.     di "  |Difference| = " %9.6f `diff_obs'
 14.     
.     * Fisher permutation test
.     * For firm-level groups (SOE), permute at firm level
.     * For time-varying groups, permute at observation level
.     
.     * Create firm-level group indicator
.     preserve
 15.     collapse (first) `dim', by(Stkcd_num)
 16.     rename `dim' orig_group
 17.     * Check if group is time-invariant (all same within firm)
.     restore
 18.     preserve
 19.     bys Stkcd_num: egen sd_group = sd(`dim')
 20.     sum sd_group
 21.     local is_timevarying = (r(max) > 0.001)
 22.     restore
 23.     
.     di "  Time-varying: `is_timevarying'"
 24.     
.     * Permutation loop
.     local pcount = 0
 25.     
.     if `is_timevarying' == 0 {
 26.         * Time-invariant: permute at firm level
.         preserve
 27.         collapse (first) `dim', by(Stkcd_num)
 28.         local n_firms = _N
 29.         local n_treated = 0
 30.         count if `dim' == 1
 31.         local n_treated = r(N)
 32.         tempfile firm_orig
 33.         save `firm_orig'
 34.         restore
 35.         
.         forval rep = 1/`nreps' {
 36.             preserve
 37.             * Create permuted group at firm level
.             merge m:1 Stkcd_num using `firm_orig', keepusing(`dim') nogen
 38.             
.             * Generate random firm-level permutation
.             tempfile obs_data
 39.             save `obs_data'
 40.             
.             use `firm_orig', clear
 41.             gen _rand = runiform()
 42.             sort _rand
 43.             gen `dim'_perm = (_n <= `n_treated')
 44.             keep Stkcd_num `dim'_perm
 45.             tempfile perm_groups
 46.             save `perm_groups'
 47.             
.             use `obs_data', clear
 48.             merge m:1 Stkcd_num using `perm_groups', nogen
 49.             
.             qui reg resid_y resid_x if `dim'_perm == 1, nocons
 50.             local b1_perm = _b[resid_x]
 51.             qui reg resid_y resid_x if `dim'_perm == 0, nocons
 52.             local b0_perm = _b[resid_x]
 53.             local diff_perm = abs(`b1_perm' - `b0_perm')
 54.             
.             if `diff_perm' >= `diff_obs' {
 55.                 local pcount = `pcount' + 1
 56.             }
 57.             restore
 58.         }
 59.     }
 60.     else {
 61.         * Time-varying: permute at observation level
.         forval rep = 1/`nreps' {
 62.             preserve
 63.             local n_treated_obs = `n_high'
 64.             gen _rand = runiform()
 65.             sort _rand
 66.             gen `dim'_perm = (_n <= `n_treated_obs')
 67.             
.             qui reg resid_y resid_x if `dim'_perm == 1, nocons
 68.             local b1_perm = _b[resid_x]
 69.             qui reg resid_y resid_x if `dim'_perm == 0, nocons
 70.             local b0_perm = _b[resid_x]
 71.             local diff_perm = abs(`b1_perm' - `b0_perm')
 72.             
.             if `diff_perm' >= `diff_obs' {
 73.                 local pcount = `pcount' + 1
 74.             }
 75.             restore
 76.         }
 77.     }
 78.     
.     local p_fisher = `pcount' / `nreps'
 79.     di "  Fisher p-value = `p_fisher' (`pcount'/`nreps')"
 80.     
.     * Store results
.     post `results' ("`dim'") (`b_high') (`b_low') (`diff_obs') (`p_fisher') (
> `n_high') (`n_low')
 81.     
.     local i = `i' + 1
 82. }

