(file /var/folders/1v/x_31wm790txgy940w5mgvhb80000gn/T//St47657.000001 not
    found)

. scalar max_abs_t_kw = 0

. 
. foreach Q in Quality_sub_z Quality_mda_z Quality_subden_z BroadShallow_cont_z
>  WashGap_z {
  2.     capture drop DUxQ
  3.     gen double DUxQ = DU_kw * `Q'
  4.     quietly reghdfe PriceDelay DU_kw `Q' DUxQ `controls', absorb(Stkcd_num
>  year_num) cluster(IndYear_num)
  5.     local b = _b[DUxQ]
  6.     local se = _se[DUxQ]
  7.     local t = `b' / `se'
  8.     local p = 2 * ttail(e(df_r), abs(`t'))
  9.     local n = e(N)
 10.     local r2 = e(r2)
 11.     if abs(`t') > max_abs_t_kw {
 12.         scalar max_abs_t_kw = abs(`t')
 13.     }
 14.     post `kw_hold' ("`Q'") ("DU_kw") (`b') (`se') (`t') (`p') (`n') (`r2')
 15.     display as text "`Q' / DU_kw: coef=" %9.4f `b' " t=" %6.2f `t' " N=" `
> n'
 16.     drop DUxQ
 17. }
