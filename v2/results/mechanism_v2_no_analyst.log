. * winsorize 机制变量 1%/99%
. foreach v in CashFlowVol SCConc Amihud lnAmihud {
  2.     qui sum `v', detail
  3.     local p1 = r(p1)
  4.     local p99 = r(p99)
  5.     replace `v' = `p1' if `v' < `p1' & !missing(`v')
  6.     replace `v' = `p99' if `v' > `p99' & !missing(`v')
  7.     display "`v' winsorize [" `p1' ", " `p99' "]"
  8. }
